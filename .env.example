BLOB_READ_WRITE_TOKEN=
DATABASE_URL=mongodb://127.0.0.1/your-database-name
DATABASE_URL_UNPOOLED=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE
RESEND_API_KEY=your_resend_api_key_here
NEXT_PUBLIC_CLUBDATA_CLIENT_ID=

# AI assistant (test page /assistent). Model calls go through Cloudflare AI Gateway (gateway "svv04").
# In the Worker through the AI binding; locally with an account id and an API token (Workers AI Read).
AI_ASSISTANT_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
# CRON_SECRET=   # protects /api/cron/sync-staff and /api/cron/reconcile-donations (Worker secret)
# Show tool calls, tokens and timing on /assistent (test only)
AI_ASSISTANT_DEBUG=false

# Tribune-fundraiser (Mollie). test_-sleutel of testprofiel-token lokaal en op previews, live alleen op Production.
MOLLIE_API_KEY=

# Zet de hele website achter deze toegangscode (leeg = geen poort). Alleen op Production zetten, als Sensitive.
SITE_ACCESS_CODE=

# Oudste appversie die nog met deze API werkt (GET /api/app/config). Verhogen als de API breekt.
APP_MIN_VERSION_IOS=1.0.0
APP_MIN_VERSION_ANDROID=1.0.0

# Cloudflare Turnstile (botcontrole op formulieren en chat). Leeg = controle uit.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare Web Analytics. Leeg = geen analytics.
NEXT_PUBLIC_CF_BEACON_TOKEN=
